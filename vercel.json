{
  "buildCommand": "pnpm install && pnpm prisma generate && pnpm run build",
  "installCommand": "pnpm install",
  "functions": {
    "api/server.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/server" },
    { "src": "/(.*)", "dest": "/index.html", "check": true }
  ]
}
