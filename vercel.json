{
  "buildCommand": "pnpm install && pnpm prisma generate --no-engine && pnpm run build",
  "installCommand": "pnpm install",
  "functions": {
    "api/server.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
