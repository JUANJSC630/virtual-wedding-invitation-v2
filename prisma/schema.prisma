generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── MASTER ADMIN (el desarrollador/dueño de la plataforma) ──────────────────
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ─── EVENTOS (cada invitación es un evento independiente) ────────────────────
model Event {
  id             String   @id @default(cuid())
  slug           String   @unique
  groomName      String
  brideName      String
  eventDate      DateTime
  rsvpDeadline   DateTime?
  venueName      String?
  venueAddress   String?
  ceremonyTime   String?
  receptionTime  String?
  dressCode      String?
  config         Json     @default("{}")
  assets         Json     @default("{}")
  theme          Json     @default("{}")
  isActive       Boolean   @default(true)
  archivedAt     DateTime?
  heroPhotoUrl   String?
  photo2Url      String?
  photo3Url      String?
  audioUrl       String?
  groomPhone     String?
  bridePhone     String?
  groomWAMessage String?
  brideWAMessage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clientAdmins  ClientAdmin[]
  guests        Guest[]
  guestAccesses GuestAccess[]

  @@map("events")
}

// ─── ADMIN DEL CLIENTE ────────────────────────────────────────────────────────
model ClientAdmin {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_admins")
}

// ─── INVITADOS ────────────────────────────────────────────────────────────────
model Guest {
  id          String    @id @default(cuid())
  eventId     String                         // requerido — todos tienen evento asignado
  event       Event     @relation(fields: [eventId], references: [id])
  code        String                         // único por evento (no globalmente)
  name        String
  email       String?
  phone       String?
  maxGuests   Int       @default(1)
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  notes       String?                        // notas internas del admin
  rsvpAnswers Json?                          // respuestas a las preguntas de config.rsvpQuestions
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companions  Companion[]
  attendees   Attendee[]                     // las personas de esta invitación

  @@unique([eventId, code])                  // código único dentro del evento
  @@map("guests")
}

// ─── ASISTENTES ───────────────────────────────────────────────────────────────
// Una fila por PERSONA. `Guest` modela el hogar/invitación (quien abre un mismo
// enlace); `Attendee` modela a cada individuo dentro de ella, titular incluido.
//
// Es el cimiento de mesas, menú por persona y check-in: un acompañante necesita
// su propia silla, su propio plato y su propio código. Ver
// INVESTIGACION_SISTEMA_COMPLETO_2026.md §1.
model Attendee {
  id          String    @id @default(cuid())
  guestId     String
  guest       Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  name        String
  isPrimary   Boolean   @default(false)      // el titular de la invitación
  // Enlace al Companion del que procede, para mantenerlos sincronizados sin
  // depender del nombre. Temporal: desaparece cuando Companion se retire.
  // Índice normal y no @unique a propósito: añadir una restricción única sobre
  // una tabla con datos hace que `db push` exija --accept-data-loss, y esa
  // bandera no se usa contra producción. La unicidad se garantiza en el código.
  companionId String?
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  rsvpAnswers Json?                          // respuestas propias (menú individual)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([guestId])
  @@index([companionId])
  @@map("attendees")
}

model Companion {
  id          String    @id @default(cuid())
  guestId     String
  guest       Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  name        String
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("companions")
}

// ─── TRACKING DE ACCESOS ──────────────────────────────────────────────────────
model GuestAccess {
  id         String   @id @default(cuid())
  eventId    String                          // requerido
  event      Event    @relation(fields: [eventId], references: [id])
  guestCode  String
  ipAddress  String?
  userAgent  String?
  accessedAt DateTime @default(now())

  @@map("guest_accesses")
}
