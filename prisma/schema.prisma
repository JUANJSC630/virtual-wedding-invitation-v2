generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── MASTER ADMIN (el desarrollador/dueño de la plataforma) ──────────────────
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ─── EVENTOS (cada invitación es un evento independiente) ────────────────────
model Event {
  id             String   @id @default(cuid())
  slug           String   @unique
  groomName      String
  brideName      String
  eventDate      DateTime
  rsvpDeadline   DateTime?
  venueName      String?
  venueAddress   String?
  ceremonyTime   String?
  receptionTime  String?
  dressCode      String?
  config         Json     @default("{}")
  assets         Json     @default("{}")
  theme          Json     @default("{}")
  isActive       Boolean   @default(true)
  archivedAt     DateTime?
  heroPhotoUrl   String?
  photo2Url      String?
  photo3Url      String?
  audioUrl       String?
  groomPhone     String?
  bridePhone     String?
  groomWAMessage String?
  brideWAMessage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clientAdmins  ClientAdmin[]
  guests        Guest[]
  guestAccesses GuestAccess[]
  tables        Table[]
  seatingRules  SeatingRule[]
  venueElements VenueElement[]

  @@map("events")
}

// ─── ADMIN DEL CLIENTE ────────────────────────────────────────────────────────
model ClientAdmin {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_admins")
}

// ─── INVITADOS ────────────────────────────────────────────────────────────────
model Guest {
  id          String    @id @default(cuid())
  eventId     String                         // requerido — todos tienen evento asignado
  event       Event     @relation(fields: [eventId], references: [id])
  code        String                         // único por evento (no globalmente)
  name        String
  email       String?
  phone       String?
  maxGuests   Int       @default(1)
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  notes       String?                        // notas internas del admin
  rsvpAnswers Json?                          // respuestas a las preguntas de config.rsvpQuestions
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companions  Companion[]
  attendees   Attendee[]                     // las personas de esta invitación

  @@unique([eventId, code])                  // código único dentro del evento
  @@map("guests")
}

// ─── ASISTENTES ───────────────────────────────────────────────────────────────
// Una fila por PERSONA. `Guest` modela el hogar/invitación (quien abre un mismo
// enlace); `Attendee` modela a cada individuo dentro de ella, titular incluido.
//
// Es el cimiento de mesas, menú por persona y check-in: un acompañante necesita
// su propia silla, su propio plato y su propio código. Ver
// INVESTIGACION_SISTEMA_COMPLETO_2026.md §1.
model Attendee {
  id          String    @id @default(cuid())
  guestId     String
  guest       Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  name        String
  isPrimary   Boolean   @default(false)      // el titular de la invitación
  // Enlace al Companion del que procede, para mantenerlos sincronizados sin
  // depender del nombre. Temporal: desaparece cuando Companion se retire.
  // Índice normal y no @unique a propósito: añadir una restricción única sobre
  // una tabla con datos hace que `db push` exija --accept-data-loss, y esa
  // bandera no se usa contra producción. La unicidad se garantiza en el código.
  companionId String?
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  rsvpAnswers Json?                          // respuestas propias (menú individual)
  // Asignación de mesa. Cuelga de la PERSONA a propósito: si alguien cancela,
  // su sitio se libera solo. Ver ARQUITECTURA_MESAS.md §2.
  tableId     String?
  table       Table?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  seatIndex   Int?                           // sitio dentro de la mesa (opcional)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([guestId])
  @@index([companionId])
  @@index([tableId])
  @@map("attendees")
}

model Companion {
  id          String    @id @default(cuid())
  guestId     String
  guest       Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  name        String
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("companions")
}

// ─── MESAS ────────────────────────────────────────────────────────────────────
// Una mesa del salón. Su ocupación NO se guarda aquí: se deriva de los Attendee
// que apuntan a ella. Ver ARQUITECTURA_MESAS.md §2.
model Table {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  name      String                            // "Mesa 1", "Novios", "Familia"
  shape     String   @default("round")        // round | rect
  capacity  Int      @default(8)
  x         Float    @default(0)              // posición en el plano
  y         Float    @default(0)
  rotation  Float    @default(0)              // solo relevante en rectangulares
  // La recomendación no toca una mesa fijada: es como se protege la
  // presidencial, la de los novios o cualquier reparto ya decidido a mano.
  locked    Boolean  @default(false)
  // "Cerca de la pista", "lejos de los altavoces", "acceso silla de ruedas"…
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendees Attendee[]

  @@index([eventId])
  @@map("tables")
}

// ─── ELEMENTOS DEL SALÓN ──────────────────────────────────────────────────────
// Pista de baile, escenario, barra, entrada… Sin ellos las mesas se colocan en
// el vacío, y las guías de montaje dependen de dónde están: los mayores lejos
// de los altavoces, sillas de ruedas cerca de los bordes, pasillos despejados.
model VenueElement {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  kind      String                            // pista | escenario | barra | entrada | buffet | otro
  label     String?                           // texto propio si se quiere
  x         Float    @default(0)
  y         Float    @default(0)
  width     Float    @default(300)
  height    Float    @default(200)
  rotation  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@map("venue_elements")
}

// ─── REGLAS DE REPARTO ────────────────────────────────────────────────────────
// Restricciones que la etiqueta impone y los datos no pueden adivinar. La más
// habitual: unos padres divorciados NO pueden compartir mesa. Se expresan entre
// INVITACIONES (hogares), que es la unidad con la que trabaja el reparto.
model SeatingRule {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])
  kind     String @default("apart")   // apart | together
  groupAId String                     // Guest.id
  groupBId String                     // Guest.id
  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("seating_rules")
}

// ─── TRACKING DE ACCESOS ──────────────────────────────────────────────────────
model GuestAccess {
  id         String   @id @default(cuid())
  eventId    String                          // requerido
  event      Event    @relation(fields: [eventId], references: [id])
  guestCode  String
  ipAddress  String?
  userAgent  String?
  accessedAt DateTime @default(now())

  @@map("guest_accesses")
}
